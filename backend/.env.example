PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Extra comma-separated origins allowed by CORS, e.g. https://shop.example.com
CORS_ORIGINS=

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smartshop_ai?schema=public

# Auth: use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AI providers (optional; tried in order Groq -> Gemini -> OpenRouter)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_MODEL=deepseek/deepseek-chat

# Payments: "auto" = Razorpay when keys are set, else a simulated gateway in development
PAYMENT_GATEWAY=auto
# Razorpay dashboard -> Settings -> API Keys (Test Mode keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard -> Webhooks (URL: https://<your-api>/api/payments/webhook, events: payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_TIMEOUT_MINUTES=30

# Event processing (outbox -> pg-boss -> handlers -> retries -> dead letter queue)
RUN_WORKERS=true
EVENT_RETRY_LIMIT=5
EVENT_RETRY_DELAY_SECONDS=5

# Email: console (log only) | resend | failing (always fails; to test retries + DLQ)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=ShopMind AI <orders@example.com>

# Rate limits per IP per 15 minutes
RATE_LIMIT_AUTH=30
RATE_LIMIT_PAYMENTS=60
