datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String
  passwordHash  String?
  avatarUrl     String?
  preferences   Json?
  cart          Cart?
  wishlist      Wishlist?
  reviews       ProductReview[]
  orders        Order[]
  conversations Conversation[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id                String             @id @default(uuid())
  name              String
  brand             String
  description       String
  price             Decimal            @db.Decimal(10, 2)
  originalPrice     Decimal?           @db.Decimal(10, 2)
  discount          Int?
  rating            Float              @default(5.0)
  reviewCount       Int                @default(0)
  image             String
  images            String[]
  specifications    Json
  features          String[]
  availability      String             @default("in-stock")
  /// Units available to sell. Reserved when an order is created, released if it's cancelled.
  stock             Int                @default(0)
  stockReservations StockReservation[]
  tags              String[]
  matchScore        Int?
  aiPros            String[]
  aiCons            String[]
  categoryId        String?
  category          Category?          @relation(fields: [categoryId], references: [id])
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]
  reviews           ProductReview[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([price])
  @@index([rating])
  @@map("products")
}

model Cart {
  id        String     @id @default(uuid())
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?    @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Wishlist {
  id        String         @id @default(uuid())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String         @unique
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  wishlistId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

model ProductReview {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int
  comment   String
  sentiment String?
  createdAt DateTime @default(now())

  @@map("product_reviews")
}

model Order {
  id                String             @id @default(uuid())
  user              User               @relation(fields: [userId], references: [id])
  userId            String
  subtotal          Decimal            @db.Decimal(10, 2)
  deliveryFee       Decimal            @default(0) @db.Decimal(10, 2)
  discount          Decimal            @default(0) @db.Decimal(10, 2)
  tax               Decimal            @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal            @db.Decimal(10, 2)
  /// pending_payment -> paid | confirmed (COD) -> cancelled
  status            String             @default("pending")
  /// "online" (payment gateway) or "cod" (cash on delivery)
  paymentMethod     String             @default("cod")
  cancelReason      String?
  trackingNumber    String?
  items             OrderItem[]
  payments          Payment[]
  stockReservations StockReservation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  @@map("order_items")
}

model Conversation {
  id        String    @id @default(uuid())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  messages  Message[]
  createdAt DateTime  @default(now())

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@map("messages")
}

// ---------- Payments & event-driven order processing

model Payment {
  id               String   @id @default(uuid())
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  /// "razorpay" or "mock" (development only)
  gateway          String
  gatewayOrderId   String   @unique
  gatewayPaymentId String?  @unique
  amount           Decimal  @db.Decimal(10, 2)
  currency         String   @default("INR")
  /// created -> paid | failed ; paid -> refunded
  status           String   @default("created")
  method           String?
  failureReason    String?
  refundId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@map("payments")
}

model StockReservation {
  id        String   @id @default(uuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  /// reserved -> committed (paid/COD) | released (cancelled)
  status    String   @default("reserved")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, productId])
  @@map("stock_reservations")
}

/// Transactional outbox: events are written in the same transaction as the change that caused them,
/// then relayed to the queue. An event can never be lost between "saved the order" and "published".
model OutboxEvent {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// Idempotency: one row per (event, handler) that has finished, so redelivered events are skipped.
model ProcessedEvent {
  eventId     String
  handler     String
  processedAt DateTime @default(now())

  @@id([eventId, handler])
  @@map("processed_events")
}

/// Events whose handler failed after all retries. Inspect and replay with `npm run dlq`.
model DeadLetterEvent {
  id         String    @id @default(uuid())
  queue      String
  eventId    String
  eventType  String
  payload    Json
  error      String?
  attempts   Int       @default(0)
  failedAt   DateTime  @default(now())
  replayedAt DateTime?

  @@index([replayedAt])
  @@map("dead_letter_events")
}
